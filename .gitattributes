# Normaliza fin de línea: los scripts de shell deben ser LF siempre,
# aunque Git trabaje en Windows con autocrlf=true (rompería los contenedores).
*.sh text eol=lf
*.bash text eol=lf

# Archivos de configuración sensibles a fin de línea
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
