# ---------------- Backend ----------------
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL / Supabase
DATABASE_URL=postgresql://proyecto_juegos:change_me@localhost:5432/proyecto_juegos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_juegos
DB_USER=proyecto_juegos
DB_PASSWORD=change_me

# Supabase Auth (validacion de JWT en el backend)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWT_SECRET=tu-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=NUNCA_COMMITEAR_ESTO

# Seguridad API
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=15000

# ---------------- Frontend ----------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
