# ---------------- Backend ----------------
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL (en Docker el host es "db"; en local, "localhost")
DATABASE_URL=postgresql://proyecto_juegos:change_me@localhost:5432/proyecto_juegos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_juegos
DB_USER=proyecto_juegos
DB_PASSWORD=change_me
# "true" solo si usas Supabase/RDS con TLS. En Docker local: "false".
DB_SSL=false

# Seguridad API
# Obligatoria en producción: firma los tokens de inicio de sesión (HS256).
JWT_SECRET=tu-secreto-seguro-y-largo-cambiar-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=15000

# ---------------- Frontend ----------------
# Vista desde el navegador (máquina que abre la página).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---------------- Pendiente (servicio externo) ----------------
# Integración con Supabase Auth: aun no conectada. El login actual es local
# (JWT propio + contraseñas cifradas con scrypt). Ver README, sección Pendientes.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key-publica
