# ---------------- Backend ----------------
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL (en Docker el host es "db"; en local, "localhost")
DATABASE_URL=postgresql://proyecto_juegos:change_me@localhost:5432/proyecto_juegos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto_juegos
DB_USER=proyecto_juegos
DB_PASSWORD=change_me
# "true" solo si usas Supabase/RDS con TLS. En Docker local: "false".
DB_SSL=false

# Seguridad API
# Obligatoria en producción: firma los tokens de inicio de sesión (HS256).
JWT_SECRET=tu-secreto-seguro-y-largo-cambiar-en-produccion
# Duración del JWT y de la cookie HttpOnly de sesión (8h, 30m, 1d...).
JWT_EXPIRES_IN=8h
# Origen(es) permitidos, separados por coma. Desde un celular en la misma red,
# usa la IP de la PC, por ejemplo http://192.168.1.10:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=15000
# Tamaño máximo de cada portada subida desde el panel (bytes). Default: 2 MB.
# MAX_UPLOAD_BYTES=2097152

# ---------------- Frontend ----------------
# URL de la API vista desde el navegador (la máquina que abre la página).
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Origen de la API para la CSP de Nginx. Debe coincidir con VITE_API_BASE_URL
# sin el sufijo /api/v1. Desde un celular: http://192.168.1.10:4000
API_ORIGIN=http://localhost:4000
# Por defecto NO se muestran los botones de autocompletado. Poner true solo
# para una demo local; las credenciales están en README.md.
VITE_SHOW_DEMO_ACCOUNTS=false

# ---------------- Supabase (base de datos remota) ----------------
# El proyecto remoto ya tiene el esquema y los datos demo. Para usarla desde la
# API, pega aquí el DATABASE_URL de Project Settings > Database > Connection
# string (Transaction pooler) y pon DB_SSL=true. No incluyas la contraseña en el repo.
# DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:6543/postgres
# DB_SSL=true
# SUPABASE_URL=https://TU-PROYECTO.supabase.co  # solo informativo; el login es propio
# Nota: Supabase Auth NO está integrado; el login usa JWT + scrypt locales.
